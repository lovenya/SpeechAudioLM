      "cosyvoice3"
    ],
    "t2a": [
      "audiogen",
      "tangoflux"
    ]
  },
  "text_prompts": {
    "speech_to_audio_description": "Based on this speech content, describe a likely environmental audio scene that could correspond to it. Return only one concise audio description suitable for text-to-audio generation. Do not explain your reasoning and do not ask follow-up questions.",
