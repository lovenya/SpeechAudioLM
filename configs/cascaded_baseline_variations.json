{
  "schema_version": 1,
  "dataset": "ttas",
  "split": "val",
  "sample_count_target": 2277,
  "combination_count": 32,
  "full_run_strategy": "single validation-split pass per selected stage/model; no data sharding unless a calibration smoke shows a wall-time problem",
  "resource_policy": {
    "cluster": "TamIA",
    "allocation_note": "TamIA GPU jobs allocate a whole H100 node; pack independent stage jobs only when peak VRAM and model placement make that safe.",
    "headroom_multiplier": 1.3,
    "parallel_stage_aggregation": {
      "wall_time_seconds": "max of parallel model/stage wall times",
      "model_load_seconds": "max of parallel model load times within the stage",
      "gpu_memory_gb": "sum of parallel model peak GPU memory",
      "gpu_hours": "sum of all participating model GPU-hours"
    }
  },
  "axes": {
    "asr": [
      "whisper",
      "qwen3_asr"
    ],
    "captioner": [
      "audio_flamingo_next",
