{
  "metrics": {
    "wer": {
      "backend": "internal"
    },
    "semantic_equivalence": {
      "backend": null,
      "model_name": null,
      "model_path": null
    },
    "asr_wer": {
      "backend": "openai-whisper",
      "python": "{environment:shared_metrics_py312}/bin/python",
      "model_name": "large-v3",
      "model_path": null,
      "cache_dir": "{model:metric_whisper}",
      "sample_rate": 16000,
      "resampling_policy": "whisper_internal"
    },
    "dwer": {
      "backend": "openai-whisper",
      "python": "{environment:shared_metrics_py312}/bin/python",
      "model_name": "large-v3",
      "model_path": null,
      "cache_dir": "{model:metric_whisper}",
      "sample_rate": 16000,
      "resampling_policy": "whisper_internal",
      "definition": "WER(ASR(reference_speech), ASR(generated_speech))"
    },
    "mace": {
      "backend": "aac-metrics",
      "python": "{environment:shared_metrics_py312}/bin/python",
      "cache_dir": "{cache:aac_metrics}",
      "hf_home": "{cache:aac_metrics}/huggingface",
      "transformers_cache": "{cache:aac_metrics}/huggingface",
      "batch_size": 1
    },
    "spider": {
      "backend": "aac-metrics",
      "python": "{environment:shared_metrics_py312}/bin/python",
      "cache_dir": "{cache:aac_metrics}",
      "hf_home": "{cache:aac_metrics}/huggingface",
      "transformers_cache": "{cache:aac_metrics}/huggingface",
      "java_max_memory": "32G"
    },
    "aac_clapsim": {
      "backend": "aac-metrics",
      "python": "{environment:shared_metrics_py312}/bin/python",
      "model_name": "MS-CLAP-2023",
      "model_path": null,
      "cache_dir": "{cache:aac_metrics}",
      "hf_home": "{cache:aac_metrics}/huggingface",
      "transformers_cache": "{cache:aac_metrics}/huggingface",
      "batch_size": 1
    },
    "target_caption_clap_score": {
      "backend": "stable-audio-metrics",
      "python": "{environment:stable_audio_metrics}/bin/python",
      "pythonpath": "{source:stable_audio_metrics}",
      "model_name": "LAION-CLAP",
      "checkpoint": "630k-audioset-fusion-best",
      "model_path": null,
      "cache_dir": "{cache:stable_audio_metrics}",
      "sample_rate": 48000,
      "resampling_policy": "backend_default"
    },
    "fense": {
      "backend": "aac-metrics",
      "python": "{environment:shared_metrics_py312}/bin/python",
      "cache_dir": "{cache:aac_metrics}",
      "hf_home": "{cache:aac_metrics}/huggingface",
      "transformers_cache": "{cache:aac_metrics}/huggingface"
    },
    "spider_max": {
      "backend": null,
      "model_name": null,
      "model_path": null
    },
    "fad": {
      "backend": "audioldm_eval",
      "python": "{environment:audioldm_eval}/bin/python",
      "model_name": "PANNs",
      "model_path": null,
      "cache_dir": "{cache:audioldm_eval}",
      "runtime_home": "{cache:runtime_home}",
      "sample_rate": 16000,
      "backbone": "cnn14",
      "minimum_valid_corpus_size": 2
    },
    "kad": {
      "backend": "kadtk",
      "python": "{environment:kadtk}/bin/python",
      "model_name": "panns-wavegram-logmel",
      "model_path": null,
      "cache_dir": "{cache:kadtk}",
      "workers": 2,
      "minimum_valid_corpus_size": 2,
      "minimum_duration_seconds": 1.0
    },
    "kl_passt": {
      "backend": "stable-audio-metrics",
      "python": "{environment:stable_audio_metrics}/bin/python",
      "pythonpath": "{source:stable_audio_metrics}",
      "model_name": "PaSST",
      "model_path": null,
      "cache_dir": "{cache:stable_audio_metrics}",
      "sample_rate": 32000,
      "resampling_policy": "backend_default"
    },
    "inception_score": {
      "backend": "audioldm_eval",
      "python": "{environment:audioldm_eval}/bin/python",
      "model_name": "PANNs",
      "model_path": null,
      "cache_dir": "{cache:audioldm_eval}",
      "runtime_home": "{cache:runtime_home}",
      "sample_rate": 16000,
      "backbone": "cnn14",
      "minimum_valid_corpus_size": 2
    },
    "utmos": {
      "backend": "utmosv2",
      "python": "{environment:shared_metrics_py312}/bin/python",
      "model_name": "UTMOSv2",
      "model_path": null,
      "cache_dir": "{cache:utmosv2}",
      "config_name": "fusion_stage3",
      "sample_rate": 16000,
      "hf_hub_offline": "1",
      "transformers_offline": "1"
    },
    "dnsmos": {
      "backend": "torchmetrics-dnsmos",
      "python": "{environment:shared_metrics_py312}/bin/python",
      "model_name": "DNSMOS",
      "model_path": null,
      "cache_dir": "{model:metric_dnsmos}",
      "sample_rate": 16000,
      "personalized": false,
      "runtime_device": "cpu",
      "num_threads": 4
    },
    "urgentmos": {
      "backend": null,
      "model_name": null,
      "model_path": null
    },
    "spk_sim": {
      "backend": null,
      "model_name": null,
      "model_path": null
    },
    "nli_contradiction": {
      "backend": "dedicated-script",
      "script": "scripts/run_nli_contradiction_helper.py",
      "script_backend": "hf",
      "model_name": "MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli",
      "contradiction_threshold": 0.7,
      "batch_size": 8,
      "note": "Helper metric for contradiction detection only; neutral is not failure and entailment is not required.",
      "local_files_only": true,
      "hf_home": "{cache:huggingface}",
      "hf_hub_offline": "1",
      "transformers_offline": "1",
      "python": "{environment:shared_metrics_py312}/bin/python"
    },
    "geval_text_plausibility": {
      "backend": "dedicated-script",
      "script": "scripts/run_geval_prometheus_criterion_v2.py",
      "script_backend": "vllm",
      "python": "{environment:prometheus_vllm}/bin/python",
      "model_name": "{model:prometheus_8x7b_v2}",
      "tensor_parallel_size": 4,
      "temperature": 0.0,
      "max_tokens": 512,
      "batch_size": 8,
      "gpu_memory_utilization": 0.85,
      "enforce_eager": true,
      "trust_remote_code": true,
      "cache_dir": "{cache:geval_text_plausibility}",
      "note": "Criterion-wise reference-free Prometheus G-Eval v2 with deterministic weighted final score."
    },
    "geval_text_reference": {
      "backend": "dedicated-script",
      "script": "scripts/run_geval_prometheus_criterion_v2.py",
      "script_backend": "vllm",
      "python": "{environment:prometheus_vllm}/bin/python",
      "model_name": "{model:prometheus_8x7b_v2}",
      "tensor_parallel_size": 4,
      "temperature": 0.0,
      "max_tokens": 512,
      "batch_size": 8,
      "gpu_memory_utilization": 0.85,
      "enforce_eager": true,
      "trust_remote_code": true,
      "cache_dir": "{cache:geval_text_reference}",
      "note": "Criterion-wise paired-reference-grounded Prometheus G-Eval v2 with deterministic weighted final score."
    },
    "geval_audio_plausibility": {
      "backend": "dedicated-script",
      "script": "scripts/run_geval_audio_qwen3_criterion.py",
      "script_backend": "transformers",
      "python": "{environment:qwen3_omni}/bin/python",
      "model_name": "{model:qwen3_omni}",
      "temperature": 0.0,
      "max_tokens": 512,
      "batch_size": 1,
      "local_files_only": true,
      "trust_remote_code": true,
      "disable_cache": true,
      "resume_from_output": true,
      "note": "Criterion-wise reference-free LALM-as-a-judge G-Eval over generated audio plus text context."
    },
    "geval_audio_reference": {
      "backend": "dedicated-script",
      "script": "scripts/run_geval_audio_qwen3_criterion.py",
      "script_backend": "transformers",
      "python": "{environment:qwen3_omni}/bin/python",
      "model_name": "{model:qwen3_omni}",
      "temperature": 0.0,
      "max_tokens": 512,
      "batch_size": 1,
      "local_files_only": true,
      "trust_remote_code": true,
      "disable_cache": true,
      "resume_from_output": true,
      "note": "Criterion-wise reference-grounded LALM-as-a-judge G-Eval over generated audio plus text and paired references."
    },
    "prompt_adherence_clap_score": {
      "backend": "stable-audio-metrics",
      "python": "{environment:stable_audio_metrics}/bin/python",
      "pythonpath": "{source:stable_audio_metrics}",
      "model_name": "LAION-CLAP",
      "checkpoint": "630k-audioset-fusion-best",
      "model_path": null,
      "cache_dir": "{cache:stable_audio_metrics}",
      "sample_rate": 48000,
      "resampling_policy": "backend_default"
    }
  }
}
